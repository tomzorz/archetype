# Xcode (Swift apps for iOS and macOS)
#   Written for projects generated by XcodeGen from a project.yml: the
#   .xcodeproj is build input produced by a tool, not source. Xcode keeps
#   DerivedData in the user profile, so most of what's left is packaging
#   output and per-user state.

# Generated project
#   XcodeGen rewrites the .xcodeproj on every run. SwiftPM's Package.resolved
#   lives inside it, so pin package versions exactly in project.yml. Delete
#   this block in a repo that commits a hand-made .xcodeproj instead.
*.xcodeproj

# Per-user state
#   Window layout, breakpoints and scheme choices, different on every machine.
xcuserdata/

# Build output
#   Only there when a script points -derivedDataPath or a build dir into the
#   repo; Xcode's own default is outside the tree.
build/
DerivedData/
*.hmap

# Swift Package Manager
#   .build/ is the package build tree. .swiftpm/ is Xcode's workspace and user
#   state for a package opened directly; Package.resolved is deliberately not
#   ignored, commit it.
.build/
.swiftpm/

# Archives, packages and symbols
#   xcodebuild archive and -exportArchive output, and the result bundles
#   -resultBundlePath writes.
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Signing credentials
#   An App Store Connect API key or an exported identity is a credential and
#   belongs in the user profile or a keychain. These lines keep a stray copy
#   out of history.
AuthKey_*.p8
*.p12
